{
  "name": "rdf-cli",
  "version": "0.3.0",
  "description": "RDF stream processing toolkit with a CLI and reusable pipeline components",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js",
    "./commands": "./src/commands/index.js",
    "./sources": "./src/sources/index.js",
    "./transforms": "./src/transforms/index.js",
    "./sinks": "./src/sinks/index.js",
    "./triplify": "./src/browser/triplify.js",
    "./pipeline": "./src/pipeline/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "rdf": "./bin/rdf.js"
  },
  "files": [
    "bin/**/*.js",
    "src/**/*.js",
    "resources/**/*.ttl",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "pnpm lint && node --test tests/*.test.js && bash tests/smoke.sh",
    "test:js": "node --test tests/*.test.js",
    "smoke": "bash tests/smoke.sh",
    "lint": "node scripts/lint-io.js && ghc -fno-code -outputdir /tmp/rdf-cli-ghc -hidir /tmp/rdf-cli-ghc -odir /tmp/rdf-cli-ghc spec/manifest.hs",
    "manifest": "node scripts/manifest.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianvasquez/rdf-cli.git"
  },
  "author": "Cristian Vasquez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cristianvasquez/rdf-cli/issues"
  },
  "homepage": "https://github.com/cristianvasquez/rdf-cli#readme",
  "dependencies": {
    "@rdfjs/formats": "^4.0.0",
    "citty": "^0.1.6",
    "get-stream": "^9.0.1",
    "glob": "^13.0.6",
    "oxigraph": "^0.5.6",
    "rdf-ext": "^2.5.1",
    "shacl-engine": "^1.1.0"
  }
}
